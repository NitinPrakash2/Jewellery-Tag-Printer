# Copy to .env and fill real values. Never commit .env with passwords.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/jewellery_tags
APP_ENV=dev
LOG_LEVEL=INFO
# Comma-separated origins allowed for the Vite dev server / desktop shell
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
